# Keep text files consistent across Windows, macOS, and Linux.
* text=auto eol=lf

# Preserve binary assets without line-ending conversion.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.exe binary
*.woff binary
*.woff2 binary
*.ttf binary

# SVG files are text and should use consistent line endings.
*.svg text eol=lf
